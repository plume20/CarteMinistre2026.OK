<Window x:Class="CarteMinistre2026.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Carte Ministre 2026" 
        Height="400" Width="450"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="#1A1A2E">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="40,0">

            <!-- Titre -->
            <TextBlock Text="CARTE MINISTRE 2026" 
                       FontSize="22" 
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Connexion" 
                       FontSize="14"
                       Foreground="#B0B0B0"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <!-- Nom d'utilisateur -->
            <TextBlock Text="Nom d'utilisateur" 
                       Foreground="#E0E0E0" 
                       Margin="0,5,0,0"
                       FontSize="12"/>
            <TextBox x:Name="UsernameTextBox" 
                     Height="35"
                     Background="#2C2C54" 
                     Foreground="#FFFFFF"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     Margin="0,5,0,15"/>

            <!-- Mot de passe -->
            <TextBlock Text="Mot de passe" 
                       Foreground="#E0E0E0" 
                       Margin="0,5,0,0"
                       FontSize="12"/>
            <PasswordBox x:Name="PasswordBox" 
                         Height="35"
                         Background="#2C2C54" 
                         Foreground="#FFFFFF"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         Margin="0,5,0,10"/>

            <!-- Message d'erreur -->
            <TextBlock x:Name="ErrorText" 
                       Foreground="#FF6B6B" 
                       TextAlignment="Center"
                       FontSize="12"
                       Margin="0,10"
                       Visibility="Collapsed"/>

            <!-- Bouton Connexion -->
            <Button Content="Se connecter" 
                    Height="40" 
                    Margin="0,20,0,0"
                    FontSize="14" 
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#E94560"
                    BorderThickness="0"
                    Click="LoginButton_Click"
                    IsDefault="True"/>

            <!-- Bouton Quitter -->
            <Button Content="Quitter" 
                    Height="35" 
                    Margin="0,10,0,0"
                    FontSize="12"
                    Foreground="#808080"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="QuitButton_Click"
                    Cursor="Hand"/>

        </StackPanel>
    </Grid>
</Window>