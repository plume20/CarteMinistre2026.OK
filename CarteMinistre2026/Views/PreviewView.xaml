<Window x:Class="CarteMinistre2026.Views.PreviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Title="Aperçu de la carte"
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize">

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Titre -->
		<TextBlock Grid.Row="0"
                   Text="Aperçu de la carte"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,15"/>

		<!-- Zone d'affichage de la carte -->
		<Border Grid.Row="1"
                Background="#16213E"
                CornerRadius="8"
                BorderBrush="#2C2C54"
                BorderThickness="1">
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Views:CardTemplate x:Name="CardTemplateControl" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

		<!-- Navigation et actions -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
			<Button Content="← Précédent"
                    Width="100" Height="35"
                    Background="#2C2C54"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Margin="0,0,10,0"
                    Click="PreviousButton_Click"
                    Cursor="Hand"/>

			<Button Content="Suivant →"
                    Width="100" Height="35"
                    Background="#2C2C54"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Margin="0,0,20,0"
                    Click="NextButton_Click"
                    Cursor="Hand"/>

			<Button Content="💾 Exporter JPG"
                    Width="120" Height="35"
                    Background="#4CAF50"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Margin="0,0,10,0"
                    Click="ExportButton_Click"
                    Cursor="Hand"/>

			<Button Content="🖨️ Imprimer"
                    Width="100" Height="35"
                    Background="#E94560"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Click="PrintButton_Click"
                    Cursor="Hand"/>
		</StackPanel>
	</Grid>
</Window>