<UserControl x:Class="CarteMinistre2026.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- Assurez-vous que l'élément racine correspond à la classe de base dans ImportView.xaml.cs (UserControl) -->
    <Grid>
        <Border CornerRadius="12" Background="#1A1A2E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Importer une liste d'employés" 
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            Background="Transparent" 
                            Foreground="#808080"
                            BorderThickness="0" 
                            FontSize="14"
                            Click="CloseButton_Click"
                            Cursor="Hand"/>
                </Grid>

                <!-- Contenu -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Fichier à importer :" Foreground="#E0E0E0" Margin="0,5"/>
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathTextBox" 
                                 Background="#2C2C54" 
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 Height="35" 
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"/>
                        <Button Grid.Column="1" 
                                Content="Parcourir" 
                                Width="80" 
                                Margin="10,0,0,0"
                                Background="#2C2C54" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Click="BrowseButton_Click"/>
                    </Grid>
                    <GroupBox Header="Format" Foreground="#E0E0E0" BorderBrush="#2C2C54" Height="125">
                        <StackPanel Margin="10">
                            <RadioButton x:Name="ExcelRadio" 
                                         Content="Fichier Excel (.xlsx, .xls)" 
                                         Foreground="#FFFFFF" 
                                         IsChecked="True" 
                                         Margin="0,5"/>
                            <RadioButton x:Name="CsvRadio" 
                                         Content="Fichier CSV (.csv)" 
                                         Foreground="#FFFFFF" 
                                         Margin="0,5"/>
                            <RadioButton x:Name="OdsRadio" 
                                         Content="Fichier ODS (.ods)" 
                                         Foreground="#FFFFFF" 
                                         Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="FirstRowHeaderCheckBox" 
                              Content="La première ligne contient les en-têtes" 
                              Foreground="#E0E0E0" 
                              IsChecked="True" 
                              Margin="0,10"/>
                </StackPanel>

                <!-- Boutons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="ImportButton" Content="Importer" 
                            Width="90" 
                            Height="35"
                            Background="#E94560" 
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Click="ImportButton_Click"/>
                    <Button Content="Annuler" 
                            Width="90" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="Transparent" 
                            Foreground="#808080"
                            BorderThickness="0"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>