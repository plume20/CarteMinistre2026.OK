<Window x:Class="CarteMinistre2026.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Height="500" Width="771"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowState="Normal">

    <Window.Resources>
        <!-- Animation de fondu pour les textes -->
        <Storyboard x:Key="FadeInAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:1.5" />
        </Storyboard>
    </Window.Resources>

    <!-- Bordure principale avec coins arrondis -->
    <Border CornerRadius="20" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.4" Color="#1A1A2E"/>
        </Border.Effect>

        <!-- Fond dégradé -->
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fond avec dégradé -->
                <Border Grid.RowSpan="5" CornerRadius="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A1A2E" Offset="0.0"/>
                            <GradientStop Color="#16213E" Offset="0.5"/>
                            <GradientStop Color="#0F3460" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Motif subtil en arrière-plan (optionnel) -->
                <Border Grid.RowSpan="5" CornerRadius="20" Opacity="0.05" Margin="-30,0,0,0">
                    <Border.Background>
                        <VisualBrush TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid>
                                    <Path Data="M0,0 L50,0 L50,50 L0,50 Z" Stroke="#FFFFFF" StrokeThickness="0.5" Fill="Transparent"/>
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>

                <!-- Logo GIF animé -->
                <Border Grid.Row="1" 
                        Width="180" Height="180"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#0C0C0C"
                        CornerRadius="90"
                        Margin="0,20,0,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="#E94560"/>
                    </Border.Effect>
                    <Image gif:ImageBehavior.AnimatedSource="/Assets/logo.png"
                           Width="160" Height="160"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- Titre principal -->
                <TextBlock Grid.Row="2"
                           Text="CARTE DE PREDICATEUR 2026"
                           FontFamily="Segoe UI"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,5"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Sous-titre -->
                <TextBlock Grid.Row="3"
                           Text="Gestion des Cartes Ministérielles"
                           FontFamily="Segoe UI Light"
                           FontSize="16"
                           Foreground="#B0B0B0"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,20"/>

                <!-- Zone de chargement -->
                <StackPanel Grid.Row="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,40">

                    <!-- Texte de chargement avec animation -->
                    <TextBlock x:Name="LoadingText"
                               Text="Chargement en cours"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="#E94560"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Window.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <!-- Barre de progression moderne -->
                    <Border Width="300" Height="4" 
                            Background="#2C2C54" 
                            CornerRadius="2"
                            HorizontalAlignment="Center">
                        <Border x:Name="ProgressBar" 
                                Width="0" 
                                HorizontalAlignment="Left"
                                CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E94560" Offset="0.0"/>
                                    <GradientStop Color="#FF6B6B" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Window.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             From="0" To="300"
                                                             Duration="0:0:2.8"
                                                             FillBehavior="HoldEnd">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Border>

                    <!-- Pourcentage (optionnel) -->
                    <TextBlock x:Name="PercentageText"
                               Text="0%"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#808080"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>