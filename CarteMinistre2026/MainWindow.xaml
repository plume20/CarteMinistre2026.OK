<Window x:Class="CarteMinistre2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carte Ministre 2026 - Accueil" 
        Height="650" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Background="#16213E" Foreground="#FFFFFF">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Importer une liste..." Command="{Binding ImportCommand}" InputGestureText="Ctrl+I"/>
                <MenuItem Header="_Exporter l'historique..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Quitter" Command="{Binding QuitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="_Édition">
                <MenuItem Header="_Concevoir le modèle de carte" Command="{Binding DesignerCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>

            <MenuItem Header="_Affichage">
                <MenuItem Header="_Actualiser" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                <MenuItem Header="_Historique des impressions" Command="{Binding HistoryCommand}" InputGestureText="Ctrl+H"/>
            </MenuItem>

            <MenuItem Header="_Aide">
                <MenuItem Header="_À propos" Click="AboutMenu_Click"/>
            </MenuItem>
        </Menu>

        <!-- Zone principale -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre et stats -->
            <Border Grid.Row="0" Background="#16213E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Liste des employés" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Sélectionnez un employé pour prévisualiser ou imprimer sa carte" 
                                   FontSize="12" Foreground="#B0B0B0" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📁 Importer" Command="{Binding ShowImportCommand}" 
                                Width="100" Height="35" Margin="0,0,10,0"
                                Background="#E94560" Foreground="#FFFFFF" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="🔄 Actualiser" Command="{Binding RefreshCommand}" 
                                Width="110" Height="35"
                                Background="#2C2C54" Foreground="#FFFFFF" BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid des employés -->
            <Border Grid.Row="1" Background="#16213E" CornerRadius="8" Padding="10">
                <DataGrid x:Name="EmployeesGrid"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#1A1A2E"
                          Foreground="#FFFFFF"
                          RowBackground="#1E2A4A"
                          AlternatingRowBackground="#223355"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2C2C54"
                          HeadersVisibility="Column">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F3460"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="40"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Width="50" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Nom" Width="120" Binding="{Binding LastName}"/>
                        <DataGridTextColumn Header="Post Nom" Width="120" Binding="{Binding PostName}"/>
                        <DataGridTextColumn Header="Prénom" Width="120" Binding="{Binding FirstName}"/>
                        <DataGridTextColumn Header="Ministère" Width="130" Binding="{Binding Ministry}"/>
                        <DataGridTextColumn Header="Fonction" Width="130" Binding="{Binding JobTitle}"/>
                        <DataGridTextColumn Header="Lieu de naissance" Width="140" Binding="{Binding BirthPlace}"/>
                        <DataGridTextColumn Header="Date de naissance" Width="120" Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="Date d'ordination" Width="130" Binding="{Binding OrdinationDate, StringFormat=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="Photo" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓"/>
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                            <Setter Property="Text" Value="✗"/>
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Barre de statut -->
        <StatusBar Grid.Row="2" Background="#0F3460" Foreground="#FFFFFF">
            <StatusBarItem>
                <TextBlock Text="© 2026 Carte Ministre - Tous droits réservés"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="👁 Aperçu" Command="{Binding PreviewCommand}" 
                            Width="90" Height="25" Margin="0,0,10,0"
                            Background="#E94560" Foreground="#FFFFFF" BorderThickness="0"
                            FontSize="12" Cursor="Hand"/>
                    <Button Content="🖨️ Imprimer" Command="{Binding PrintCommand}" 
                            Width="100" Height="25"
                            Background="#4CAF50" Foreground="#FFFFFF" BorderThickness="0"
                            FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>